# 复制本文件为 .env，填入你自己的密钥。
#
#   Copy-Item mini-agent\.env.example mini-agent\.env
#   notepad mini-agent\.env
#
# .env 已在 .gitignore 中，不会被提交。
# ⚠️ 不要把密钥贴进聊天窗口、截图或代码里 —— 只放这个文件。

# 本项目只需要一个「OpenAI 兼容」接口，换平台只改下面这三行。
# MODEL 的名字各家会变，务必以你用那个平台的「模型列表」页为准，
# 不要照抄网上教程里的旧名字，否则会得到 404 model not found。

# ===== 方案 A：DeepSeek（国内直连、中文文档最全，推荐）=====
OPENAI_API_KEY=sk-在这里填你的key
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# ===== 方案 B：智谱 GLM =====
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL=（去 bigmodel.cn 的模型列表页确认当前可用的模型名）

# ===== 方案 C：Kimi（月之暗面）=====
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# MODEL=（去 platform.moonshot.cn 确认）

# ===== 方案 D：SiliconFlow（国内直连多家开源模型）=====
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# MODEL=（去 siliconflow.cn 确认）

# ===== 方案 E：OpenRouter（海外聚合，需能访问外网）=====
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL=（去 openrouter.ai/models 确认）
